# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
#
# .env NO se sube a Git (está en .gitignore).

# PostgreSQL — servicio bd_main en docker-compose
POSTGRES_USER=aos_user
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=agenda_online_simple
POSTGRES_PORT=5432

# Backend NestJS (hostname bd_main = red interna de Docker)
DATABASE_URL=postgresql://aos_user:changeme_dev_only@bd_main:5432/agenda_online_simple

# Zona horaria IANA
TZ=America/Santiago
PGTZ=America/Santiago

# Traefik (dev)
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Frontend Next.js (desde el navegador del host)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# CORS — orígenes del frontend
CORS_ORIGINS=http://localhost:3001,http://agenda.localhost

# Cloudflare R2 (assets / multimedia) — BUCKET PRIVADO
# Metadata en tabla `assets`; binario en R2. file_path = object key (no URL pública).
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_SYSTEM=agenda-online-simple

# Redis — Socket.IO adapter (tiempo real entre réplicas de api)
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Rate limit APIs públicas (@nestjs/throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Documentación API: OpenAPI (@nestjs/swagger) + UI Scalar
# Dev: on por defecto. Prod: off salvo SWAGGER_ENABLED=true
# UI → /api/reference   JSON → /api/docs/json
# SWAGGER_ENABLED=true

# Detrás de Traefik
TRUST_PROXY=false

# Google OAuth — SOLO para que el cliente confirme identidad al agendar
# (no es alta de usuarios internos / no es registro SaaS del panel)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# JWT del panel interno (login email+password; openssl rand -base64 48 en prod)
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# JWT booking one-shot (cliente Google → confirmar cita; distinto del panel)
JWT_BOOKING_SECRET=change_me_booking_secret_dev_only
JWT_BOOKING_EXPIRES_IN=15m

# Tras Google OAuth, redirect al frontend con ?booking_token=
BOOKING_FRONTEND_REDIRECT=http://localhost:3001

# Resend — emails transaccionales (confirmación, cancelación, reset, recordatorios)
# Completa con tu API key y dominio verificado en Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@tudominio.cl
RESEND_FROM_NAME=Agenda online simple

# Links en emails (reset password / cancelar cita)
APP_PUBLIC_URL=http://localhost:3001
